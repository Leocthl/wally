{
  "name": "@wally/harness",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Seeded replay harness, B0/B1/B2 metrics (lane D). Reuses core and rail-sim, never copies them",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "harness": "tsx src/cli.ts"
  },
  "dependencies": {
    "@wally/agent": "workspace:*",
    "@wally/core": "workspace:*",
    "@wally/rail-sim": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.23.15"
  }
}
