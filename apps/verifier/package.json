{
  "name": "@laisee/verifier",
  "version": "0.0.0",
  "private": true,
  "description": "Offline log verifier: one self-contained index.html (lane C). Imports only @laisee/core/verify and types",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "@laisee/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "vite": "^8.3.2"
  }
}
