{
  "name": "laisee-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Lai See Agent: sealed-budget mandate engine for AI shopping agents (rail SIMULATED)",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "pnpm --filter @laisee/core test:coverage",
    "build": "pnpm -r build",
    "gen:types": "node scripts/gen-types.mjs",
    "docs:check": "python3 scripts/docs-check.py",
    "harness": "pnpm --filter @laisee/harness harness",
    "keys:gen": "node scripts/keys-gen.mjs",
    "verify-log": "node scripts/verify-log.mjs",
    "demo:reset": "node -e \"console.log('demo:reset is TBD (lane X, after X-10)')\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "json-schema-to-typescript": "^16.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
