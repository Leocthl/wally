# Copy to .env. Never commit .env. No card numbers or CVV in any env file (I8).
# The demo runs with zero API keys: judge = local Laya, planner = rule (or replay).

JUDGE_PROVIDER=laya                      # laya | jev | replay
JUDGE_MODE=enforce                       # enforce (the demo) | shadow: records the judge but never blocks, a judge outage is then ignored
LAYA_BASE_URL=http://127.0.0.1:8808      # services/laya/serve.sh
LAYA_MODEL=typed-decisions               # always send this model name
LAYA_ALLOW_REMOTE=                       # set to 1 only to point LAYA_BASE_URL at a non-loopback host (listing text then leaves this Mac)
LAYA_API_KEY=                            # optional, only for such a remote Laya

PLANNER_PROVIDER=auto                    # auto | rule | replay | local. auto (default): local if PLANNER_BASE_URL/health answers in 1.5 s, else rule if Laya does, else replay; chosen once at start. A named value wins. No key
PLANNER_BASE_URL=http://127.0.0.1:8809   # local planner and Seal compiler: services/qwen/serve.sh (llama-server, Qwen3.5)
PLANNER_MODEL=qwen3.5-9b-q4km            # alias serve.sh gives the model: qwen3.5-9b-q4km (QWEN_MODEL=9b) | qwen3.5-4b-q4km (QWEN_MODEL=4b)
PLANNER_ALLOW_REMOTE=                    # set to 1 only to point PLANNER_BASE_URL at a non-loopback host (the shopper request then leaves this Mac)

# Optional hosted Jev (F11b). Empty key => not used.
JEV_BASE_URL=
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=

RAIL_MODE=sim                            # sim only. The real card test is typed by a human, never wired in
KEY_DIR=./.keys                          # throwaway demo keys, gitignored
LOG_DIR=./.data/logs                     # append-only JSONL, gitignored

# Booth server (apps/web/server, pnpm demo). Binds 127.0.0.1 only; pnpm demo:lan is the opt-in LAN mode for phones.
PORT=8787                                # API, SSE trace, built UI at /, verifier page at /verifier/
# HOST=0.0.0.0                           # another bind address; anything but loopback turns LAN mode on (pairing token, QR code)
# WALLY_SESSIONS=on                      # on | off. Phones on the booth Wi-Fi each get a practice wallet of their own (own keys, log, budget); the Mac keeps the shared one. Unset: on with LAN mode, off without. Any other value counts as off
# WALLY_PUBLIC_URL=https://wally-dev.vercel.app   # the practice copy (works on any network): a second QR code and link under the Wi-Fi one on the Mac. http(s) only. Unset: not shown

# Optional switches read by the scripts and the dev server. Every one has a default; none is a secret.
# QWEN_MODEL=9b                          # 9b | 4b: which model services/qwen/serve.sh serves (PLANNER_MODEL above must match)
# QWEN_VISION=on                         # on | off: off serves text only, so Show Wally a photo falls back to the colour chips (9b only)
# QWEN_IMAGE_MAX_TOKENS=512              # most tokens one picture may cost
# QWEN_SPEC=mtp                          # mtp | off: speculative decoding
# QWEN_SKIP_VERIFY=                      # set to 1 to skip the SHA-256 check of the weights at start
# QWEN_CACHE_DIR=                        # read the GGUF files from another folder
# LAYA_DEVICE=                           # mps | cpu (default: mps if torch reports it)
# LAYA_THREADS=                          # torch threads for Laya (default: the physical cores)
# LAYA_URL=http://127.0.0.1:8808         # read only by the live planner test
# VITE_API=                              # local builds the on-device app (no /api call); pnpm pages:build sets it
# WALLY_API_PORT=8787                    # the dev server's /api proxy target (pnpm --filter @wally/web dev)
# WALLY_E2E_PORT=4517                    # port of the Playwright preview; change it to run two checkouts at once
# WALLY_EDGE_TO_EDGE=                    # 1 keeps viewport-fit=cover in the native shells (apps/mobile/README.md)
# BOOTH_UP_NO_BOOTH=                     # 1 makes pnpm booth stop after the warm-up
