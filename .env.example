# Copy to .env. Never commit .env. No card numbers or CVV in any env file (I8).
# Model strings: VERIFY against the provider before first use.

ANTHROPIC_API_KEY=
PLANNER_MODEL=claude-opus-5-5            # VERIFY. Speed option if the planner timeout is missed: claude-sonnet-5-5

JUDGE_PROVIDER=jev                       # jev | llm
TYPESAFE_API_KEY=                        # early access, waitlisted. Empty => JUDGE_PROVIDER=llm
JEV_MODEL=jev-1.13.0                     # read from docs.typesafe.ai 2026-10-02 (F11b). Pin it; do not use jev-latest while tuning thresholds
JUDGE_FALLBACK_MODEL=claude-haiku-4-5    # VERIFY. Used when JUDGE_PROVIDER=llm or Jev fails
JUDGE_MODE=shadow                        # shadow | enforce

RAIL_MODE=sim                            # sim only. The real card test is typed by a human, never wired in
KEY_DIR=./.keys                          # throwaway demo keys, gitignored
LOG_DIR=./.data/logs                     # append-only JSONL, gitignored
