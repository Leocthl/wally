# Copy to .env. Never commit .env. No card numbers or CVV in any env file (I8).
# The demo runs with zero API keys: judge = local Laya, planner = rule (or replay).

JUDGE_PROVIDER=laya                      # laya | jev | replay
JUDGE_MODE=enforce                       # enforce (the demo) | shadow: records the judge but never blocks, a judge outage is then ignored
LAYA_BASE_URL=http://127.0.0.1:8808      # services/laya/serve.sh
LAYA_MODEL=typed-decisions               # always send this model name
LAYA_ALLOW_REMOTE=                       # set to 1 only to point LAYA_BASE_URL at a non-loopback host (listing text then leaves this Mac)
LAYA_API_KEY=                            # optional, only for such a remote Laya

PLANNER_PROVIDER=rule                    # rule | replay (reads LAYA_BASE_URL too; no other model, no key)

# Optional hosted Jev (F11b). Empty key => not used.
JEV_BASE_URL=
JEV_MODEL=jev-1.13.0
TYPESAFE_API_KEY=

RAIL_MODE=sim                            # sim only. The real card test is typed by a human, never wired in
KEY_DIR=./.keys                          # throwaway demo keys, gitignored
LOG_DIR=./.data/logs                     # append-only JSONL, gitignored
